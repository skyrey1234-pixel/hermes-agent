# Base44 sandbox defaults — placeholders only.
# Listed FIRST in the compose `env_file:` list so real values from
# /run/base44/app.env always win.

# Username for the dashboard's password login. A public (non-loopback) bind
# always requires an auth provider, and the provider refuses to register
# without a username; the password itself comes from the app secrets.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
